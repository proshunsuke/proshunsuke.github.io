{
  "name": "proshunsuke.github.io",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/finalize-build.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vp test run",
    "test:unit": "vp test run --project node",
    "test:browser": "vp test run --project browser",
    "test:e2e": "npm run build && node scripts/verify-build.mjs && playwright test",
    "test:e2e:built": "playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:install": "playwright install chromium firefox webkit",
    "skills:list": "skills list",
    "skills:update": "skills update react-router workers-best-practices wrangler --project --yes && skills add https://github.com/microsoft/playwright/tree/main/packages/playwright-core/src/tools/skills/playwright-cli --agent codex --skill playwright-cli --yes",
    "check": "npm run typecheck && vp check && npm test",
    "preview": "vp preview",
    "lint": "vp lint .",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "og": "node scripts/og-images.mjs",
    "predev": "npm run og",
    "prebuild": "npm run og",
    "pretypecheck": "npm run og",
    "pretest": "npm run og",
    "pretest:unit": "npm run og",
    "pretest:browser": "npm run og"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "isbot": "^5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "rehype-external-links": "^3.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@react-router/fs-routes": "^8.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.1",
    "satori": "^0.33.4",
    "sirv": "^3.0.2",
    "skills": "^1.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1",
    "vitest-browser-react": "^2.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
