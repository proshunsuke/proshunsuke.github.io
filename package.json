{
  "name": "proshunsuke.github.io",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/finalize-build.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:e2e": "npm run build && node scripts/verify-build.mjs && playwright test",
    "test:e2e:built": "playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:install": "playwright install chromium firefox webkit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "preview": "vite preview",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "isbot": "^5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@react-router/fs-routes": "^8.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "sirv": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
