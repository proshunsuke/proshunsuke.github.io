{
  "name": "cms-auth",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run build && node --test *.test.mjs",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit",
    "build": "esbuild worker.ts --format=esm --target=es2022 --outfile=dist/worker.js",
    "deploy": "wrangler deploy dist/worker.js --no-bundle",
    "verify:deployment": "node verify-deployment.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20260916.0-alpha",
    "typescript": "7.0.2",
    "wrangler": "4.133.0"
  }
}
